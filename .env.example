# =============================================================================
# AI-ACCELERATE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and replace placeholder values with your actual credentials

# =============================================================================
# GOOGLE CLOUD GEMINI (FREE TIER)
# =============================================================================

# Get free API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/minute, 1500 requests/day
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Model configuration
GOOGLE_MODEL=gemini-2.0-flash-exp
GOOGLE_REGION=us-central1

# =============================================================================
# ELASTICSEARCH CLOUD (FREE 14-DAY TRIAL)
# =============================================================================

# Get from: https://cloud.elastic.co/
# CORRECT FORMAT: deployment_name:your_cloud_id_here
ELASTIC_CLOUD_ID=your_deployment_name:your_cloud_id_here

# METHOD 1: API Key (recommended)
ELASTIC_API_KEY=your_elastic_api_key_here

# METHOD 2: Username/Password (alternative)
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=your_elastic_password_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# App configuration
APP_NAME=AI-Accelerate
APP_VERSION=1.0.0
DEBUG_MODE=True

# Streamlit configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# =============================================================================
# OPTIONAL SERVICES (for enhanced features)
# =============================================================================

# OpenAI backup (has $5 free credits)
# OPENAI_API_KEY=your_openai_key_optional

# Additional search APIs (free tiers available)
# GOOGLE_CUSTOM_SEARCH_API_KEY=your_free_search_key
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your_search_engine_id

# =============================================================================
# HACKATHON DEMO SETTINGS
# =============================================================================

# Demo mode settings
DEMO_MODE=True
SAMPLE_DATA=True
MOCK_RESPONSES=False